{
  "name": "blog-iurchenkov-com",
  "type": "module",
  "version": "1.0.0",
  "engines": {
    "node": ">=22.12.0",
    "bun": "1.4.0"
  },
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 bun --bun astro dev",
    "check": "ASTRO_TELEMETRY_DISABLED=1 bun --bun astro check && bun run lint && bun run format:check",
    "build": "ASTRO_TELEMETRY_DISABLED=1 bun --bun astro build && bun --bun pagefind --site dist",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 bun --bun astro preview",
    "sync": "ASTRO_TELEMETRY_DISABLED=1 bun --bun astro sync",
    "format:check": "bun --bun prettier --check .",
    "format": "bun --bun prettier --write .",
    "lint": "bun --bun eslint .",
    "test": "bun test",
    "verify": "bun scripts/verify.ts",
    "test:articles": "bun scripts/test-articles.ts"
  },
  "dependencies": {
    "@astrojs/mdx": "^6.0.1",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.3",
    "@tailwindcss/vite": "^4.3.0",
    "astro": "^6.4.2",
    "dayjs": "^1.11.21",
    "lodash.kebabcase": "^4.1.1",
    "rehype-callouts": "^2.1.2",
    "remark-collapse": "^0.1.2",
    "remark-toc": "^9.0.0",
    "satori": "^0.26.0",
    "sharp": "^0.34.5",
    "slugify": "^1.6.9",
    "tailwindcss": "^4.3.0",
    "remark-math": "^6.0.0",
    "rehype-katex": "^7.0.1",
    "katex": "^0.16.22",
    "rehype-mermaid": "^3.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/markdown-remark": "^7.2.0",
    "@pagefind/default-ui": "^1.5.2",
    "@shikijs/transformers": "^4.1.0",
    "@tailwindcss/typography": "^0.5.19",
    "@types/bun": "^1.4.4",
    "@types/hast": "^3.0.4",
    "@types/lodash.kebabcase": "^4.1.9",
    "@typescript-eslint/parser": "^8.60.0",
    "eslint": "^10.4.1",
    "eslint-plugin-astro": "^1.7.0",
    "pagefind": "^1.5.2",
    "playwright": "^1.56.0",
    "prettier": "3.8.3",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "^6.0.3",
    "unist-util-visit": "^5.0.0"
  },
  "private": true,
  "packageManager": "bun@1.4.0"
}
